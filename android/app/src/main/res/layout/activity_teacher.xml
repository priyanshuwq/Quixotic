<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Teacher Mode"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready to translate"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvLatency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Latency: 0ms"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnStartTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Translation"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnStopTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Translation"/>

</LinearLayout>
