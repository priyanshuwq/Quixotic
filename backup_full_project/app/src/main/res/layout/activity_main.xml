<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1B5E20"
            android:padding="14dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BhashaSetu"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hindi \u2194 Santali | Offline"
                android:textSize="12sp"
                android:textColor="#C8E6C9" />
        </LinearLayout>

        <!-- Offline Status -->
        <TextView
            android:id="@+id/tvOfflineStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking offline status..."
            android:textSize="11sp"
            android:textColor="#666666"
            android:gravity="center"
            android:padding="6dp"
            android:background="#FFF9C4" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hindi \u2192 Santali"
            android:textSize="14sp"
            android:textColor="#1B5E20"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:background="#E8F5E9" />

        <!-- Source Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_margin="10dp">

            <TextView
                android:id="@+id/tvSourceLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Speak or type in Hindi"
                android:textSize="11sp"
                android:textColor="#888888"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvSourceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waiting for input..."
                android:textSize="22sp"
                android:textColor="#333333"
                android:paddingTop="4dp"
                android:minHeight="36dp" />
        </LinearLayout>

        <!-- Text Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingBottom="6dp">

            <EditText
                android:id="@+id/etTextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Type Hindi text..."
                android:inputType="text"
                android:textSize="16sp"
                android:padding="10dp"
                android:background="@drawable/input_background"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnTranslate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Go"
                android:backgroundTint="#1B5E20"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

        <!-- Arrow -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u25BC"
            android:textSize="18sp"
            android:textColor="#1B5E20"
            android:gravity="center" />

        <!-- Target Card - Ol Chiki -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvTargetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Santali (Ol Chiki)"
                android:textSize="11sp"
                android:textColor="#888888"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvTargetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Translation will appear here..."
                android:textSize="24sp"
                android:textColor="#1B5E20"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:minHeight="36dp" />
        </LinearLayout>

        <!-- Devanagari for TTS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF3E0"
            android:padding="12dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="For Audio (Devanagari)"
                android:textSize="11sp"
                android:textColor="#888888"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvDevanagariText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spoken version will appear here..."
                android:textSize="18sp"
                android:textColor="#E65100"
                android:paddingTop="4dp"
                android:minHeight="32dp" />
        </LinearLayout>

        <!-- Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp">

            <!-- Mic -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="16dp">

                <ImageButton
                    android:id="@+id/btnMic"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_mic"
                    android:background="@drawable/circle_button_green"
                    android:scaleType="centerInside"
                    android:padding="16dp"
                    android:contentDescription="Speak" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speak"
                    android:textSize="10sp"
                    android:textColor="#666666"
                    android:paddingTop="2dp" />
            </LinearLayout>

            <!-- Switch -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="16dp">

                <Button
                    android:id="@+id/btnSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Clear"
                    android:textSize="11sp"
                    android:backgroundTint="#0D47A1"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

            <!-- Speak -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnSpeak"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_speaker"
                    android:background="@drawable/circle_button_blue"
                    android:scaleType="centerInside"
                    android:padding="16dp"
                    android:contentDescription="Play sound" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hear"
                    android:textSize="10sp"
                    android:textColor="#666666"
                    android:paddingTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIH 2026 | Government of Jharkhand"
            android:textSize="10sp"
            android:textColor="#999999"
            android:gravity="center"
            android:paddingBottom="10dp" />

    </LinearLayout>
</ScrollView>
